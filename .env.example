# Model provider — set one. A vision-capable model is needed for the agent
# to inspect image evidence itself.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# `pnpm dev` signs you in automatically on localhost, so login needs no setting.
# AUTH_DISABLED=true makes every request one shared account. The server refuses
# to start with it outside NODE_ENV=development/test; never set it on a deployment.
# AUTH_DISABLED=true

# Local database (PGlite, created on first run)
# DATABASE_URL=pglite:./data/pglite

# Custom health check message
PING_MESSAGE=pong
