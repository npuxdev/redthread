# Model provider — set one. A vision-capable model is needed for the agent
# to inspect image evidence itself.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Skip login/signup (local dev / preview only)
AUTH_DISABLED=true

# Local database (PGlite, created on first run)
# DATABASE_URL=pglite:./data/pglite

# Custom health check message
PING_MESSAGE=pong
